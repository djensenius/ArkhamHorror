{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkhamhorror.app/contracts/name.schema.json",
  "title": "Name",
  "description": "A display name with an optional subtitle (Arkham.Name), used by investigators and scenarios.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "subtitle"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
