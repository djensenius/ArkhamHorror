{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkhamhorror.app/contracts/replay-attestation.schema.json",
  "title": "ReplayAttestation",
  "description": "Authenticated, game-bound authority for the independently validated state of a deterministic replay checkpoint import.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gameId",
    "gameGitRevision",
    "checkpointSha256",
    "canonicalEnvelopeSha256",
    "validatedCheckpoint",
    "runningServerBuild",
    "importReceipt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "gameId": {
      "$ref": "#/$defs/uuid"
    },
    "gameGitRevision": {
      "$ref": "#/$defs/gitSha"
    },
    "checkpointSha256": {
      "$ref": "#/$defs/sha256"
    },
    "canonicalEnvelopeSha256": {
      "$ref": "#/$defs/sha256",
      "description": "Server-recomputed identity of the canonical export-plus-metadata envelope. It binds the imported bytes but does not authenticate self-reported generation history."
    },
    "validatedCheckpoint": {
      "$ref": "#/$defs/validatedCheckpoint"
    },
    "runningServerBuild": {
      "$ref": "#/$defs/replayBuildIdentity"
    },
    "importReceipt": {
      "$ref": "#/$defs/importReceipt"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "buildIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gitRevision",
        "gitTree",
        "sourceSha256",
        "sourceClean",
        "attestation"
      ],
      "properties": {
        "gitRevision": {
          "$ref": "#/$defs/gitSha"
        },
        "gitTree": {
          "$ref": "#/$defs/gitSha"
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceClean": {
          "type": "boolean"
        },
        "attestation": {
          "enum": [
            "git-clean",
            "source-sha256",
            "unattested"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "sourceClean",
            "attestation"
          ],
          "properties": {
            "sourceClean": {
              "const": true
            },
            "attestation": {
              "const": "git-clean"
            }
          }
        },
        {
          "required": [
            "sourceClean",
            "attestation"
          ],
          "properties": {
            "sourceClean": {
              "const": false
            },
            "attestation": {
              "enum": [
                "source-sha256",
                "unattested"
              ]
            }
          }
        }
      ]
    },
    "replayBuildIdentity": {
      "allOf": [
        {
          "$ref": "#/$defs/buildIdentity"
        },
        {
          "properties": {
            "sourceClean": {
              "const": true
            },
            "attestation": {
              "const": "git-clean"
            }
          }
        }
      ]
    },
    "validatedPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionVersion",
        "playerId",
        "promptTag",
        "promptSha256"
      ],
      "properties": {
        "questionVersion": {
          "type": "integer",
          "minimum": 1
        },
        "playerId": {
          "$ref": "#/$defs/uuid"
        },
        "promptTag": {
          "type": "string",
          "minLength": 1
        },
        "promptSha256": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 of the compact UTF-8 prompt JSON after recursively sorting every object key lexically."
        }
      }
    },
    "validatedCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "contractSchemaRevision",
        "prompt",
        "checkpointGameSha256",
        "checkpointQueueSha256"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "contractSchemaRevision": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "prompt": {
          "$ref": "#/$defs/validatedPrompt"
        },
        "checkpointGameSha256": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 recomputed by the server from the decoded checkpoint game."
        },
        "checkpointQueueSha256": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 recomputed by the server from the decoded retained queue."
        }
      }
    },
    "playerRemapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "investigatorId",
        "checkpointPlayerId",
        "importedPlayerId",
        "livePlayerId",
        "stateRemapped"
      ],
      "properties": {
        "investigatorId": {
          "type": "string",
          "minLength": 1
        },
        "checkpointPlayerId": {
          "$ref": "#/$defs/uuid"
        },
        "importedPlayerId": {
          "$ref": "#/$defs/uuid"
        },
        "livePlayerId": {
          "$ref": "#/$defs/uuid"
        },
        "stateRemapped": {
          "type": "boolean"
        }
      }
    },
    "importReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "gameId",
        "gameGitRevision",
        "backendBuild",
        "checkpointSha256",
        "canonicalEnvelopeSha256",
        "validatedCheckpoint",
        "playerRemappings",
        "receiptSha256"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "gameId": {
          "$ref": "#/$defs/uuid"
        },
        "gameGitRevision": {
          "$ref": "#/$defs/gitSha"
        },
        "backendBuild": {
          "$ref": "#/$defs/replayBuildIdentity"
        },
        "checkpointSha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonicalEnvelopeSha256": {
          "$ref": "#/$defs/sha256",
          "description": "Server-recomputed identity of the canonical export-plus-metadata envelope. It binds the imported bytes but does not authenticate self-reported generation history."
        },
        "validatedCheckpoint": {
          "$ref": "#/$defs/validatedCheckpoint"
        },
        "playerRemappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/playerRemapping"
          }
        },
        "receiptSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
