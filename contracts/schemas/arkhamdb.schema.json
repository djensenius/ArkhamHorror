{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkhamhorror.app/contracts/arkhamdb.schema.json",
  "title": "ArkhamDB account linking, private decks and opt-in campaign write-back",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "linkStart",
    "linkedStatus",
    "unlinkedStatus",
    "decks",
    "importRequest",
    "error",
    "importedDeck",
    "syncedDeck",
    "completionRequest",
    "tokenExpiredError"
  ],
  "properties": {
    "linkStart": {
      "$ref": "#/$defs/linkStart"
    },
    "linkedStatus": {
      "$ref": "#/$defs/linkStatus"
    },
    "unlinkedStatus": {
      "$ref": "#/$defs/linkStatus"
    },
    "decks": {
      "$ref": "#/$defs/deckList"
    },
    "importRequest": {
      "$ref": "#/$defs/importRequest"
    },
    "error": {
      "$ref": "#/$defs/error"
    },
    "importedDeck": {
      "$ref": "./decks.schema.json#/$defs/deck"
    },
    "syncedDeck": {
      "$ref": "./decks.schema.json#/$defs/deck"
    },
    "completionRequest": {
      "$ref": "#/$defs/completionRequest"
    },
    "tokenExpiredError": {
      "$ref": "#/$defs/error"
    }
  },
  "$defs": {
    "linkStart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizeUrl",
        "expiresAt"
      ],
      "properties": {
        "authorizeUrl": {
          "type": "string",
          "format": "uri"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "linkStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linked",
        "remoteAccountId",
        "remoteAccountName",
        "tokenExpiry",
        "linkedAt",
        "writeBackEnabledDeckCount",
        "deckLinks"
      ],
      "properties": {
        "linked": {
          "type": "boolean"
        },
        "remoteAccountId": {
          "type": [
            "string",
            "null"
          ]
        },
        "remoteAccountName": {
          "type": [
            "string",
            "null"
          ]
        },
        "tokenExpiry": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "linkedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "writeBackEnabledDeckCount": {
          "type": "integer",
          "minimum": 0
        },
        "deckLinks": {
          "$ref": "#/$defs/writeBackStatusList"
        }
      }
    },
    "deckSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "url",
        "investigatorName",
        "lastUpdatedAt",
        "version",
        "linkedLocalDeckId"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "investigatorName": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastUpdatedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "linkedLocalDeckId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "deckList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deckSummary"
      }
    },
    "importRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deckId"
      ],
      "properties": {
        "deckId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "error"
      ],
      "properties": {
        "code": {
          "enum": [
            "disabled",
            "oauthCallbackInvalidState",
            "notLinked",
            "tokenExpired",
            "notFound",
            "storageFailure",
            "remoteUnavailable",
            "oauthCompletionInvalid",
            "writeBackDisabled",
            "conflict",
            "pushUncertain",
            "validationFailed"
          ]
        },
        "error": {
          "type": "string"
        }
      }
    },
    "completionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completion"
      ],
      "properties": {
        "completion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "writeBackConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "lastSyncedDateUpdate",
        "lastSyncedVersion",
        "remoteDateUpdate",
        "remoteVersion"
      ],
      "properties": {
        "reason": {
          "enum": [
            "remoteChanged",
            "campaignChanged",
            "pushUncertain",
            "targetAlreadyLinked",
            "boundaryUndone"
          ]
        },
        "lastSyncedDateUpdate": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastSyncedVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "remoteDateUpdate": {
          "type": [
            "string",
            "null"
          ]
        },
        "remoteVersion": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "writeBackStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localDeckId",
        "remoteDeckId",
        "enabled",
        "state",
        "pushId",
        "campaignKey",
        "error",
        "conflict",
        "resultingLocalDeckId",
        "spentXpSynced"
      ],
      "properties": {
        "localDeckId": {
          "type": "string",
          "format": "uuid"
        },
        "remoteDeckId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "idle",
            "pending",
            "running",
            "failed",
            "conflict",
            "succeeded",
            "cancelled"
          ]
        },
        "pushId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "campaignKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "conflict": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/writeBackConflict"
            }
          ]
        },
        "resultingLocalDeckId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "spentXpSynced": {
          "const": false,
          "description": "No authoritative upgrade-cost value exists in the server or upgrade request. Set spent XP manually on ArkhamDB before the next version upgrade."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "conflict"
              }
            }
          },
          "then": {
            "properties": {
              "conflict": {
                "$ref": "#/$defs/writeBackConflict"
              }
            }
          },
          "else": {
            "properties": {
              "conflict": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "writeBackStatusList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/writeBackStatus"
      }
    },
    "toggleRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "resolveRequest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resolution"
          ],
          "properties": {
            "resolution": {
              "const": "keepRemote"
            },
            "confirmed": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resolution",
            "confirmed"
          ],
          "properties": {
            "resolution": {
              "enum": [
                "overwrite",
                "saveAsNew"
              ]
            },
            "confirmed": {
              "const": true
            }
          }
        }
      ]
    }
  }
}
