{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkhamhorror.app/contracts/get-game.schema.json",
  "title": "GetGame",
  "description": "Participant or spectator view of a game.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "playerId",
    "multiplayerMode",
    "game",
    "eventId"
  ],
  "properties": {
    "playerId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "multiplayerMode": {
      "enum": [
        "Solo",
        "WithFriends"
      ]
    },
    "game": {
      "$ref": "./public-game.schema.json"
    },
    "eventId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  }
}
