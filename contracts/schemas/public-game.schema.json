{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkhamhorror.app/contracts/public-game.schema.json",
  "title": "PublicGame",
  "description": "Top-level authoritative game snapshot published over REST and WebSocket.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tag",
    "name",
    "id",
    "log",
    "git",
    "settings",
    "gameSettings",
    "mode",
    "modifiers",
    "encounterDeckSize",
    "locations",
    "investigators",
    "otherInvestigators",
    "killedInvestigators",
    "enemies",
    "assets",
    "acts",
    "agendas",
    "treacheries",
    "events",
    "concealed",
    "skills",
    "stories",
    "scarletKeys",
    "playerCount",
    "activeInvestigatorId",
    "activePlayerId",
    "turnPlayerInvestigatorId",
    "leadInvestigatorId",
    "playerOrder",
    "phase",
    "phaseStep",
    "inAction",
    "skillTest",
    "skillTestChaosTokens",
    "focusedCards",
    "highlightedCards",
    "focusedTarotCards",
    "foundCards",
    "focusedChaosTokens",
    "activeCard",
    "removedFromPlay",
    "gameState",
    "inSetup",
    "skillTestResults",
    "question",
    "cards",
    "totalDoom",
    "totalClues",
    "scenarioSteps",
    "undoActionStep",
    "undoTurnStep",
    "undoPhaseStep",
    "undoRoundStep",
    "roundHistory",
    "phaseHistory",
    "turnHistory",
    "enemyAttackTargets"
  ],
  "properties": {
    "tag": {
      "const": "PublicGame"
    },
    "name": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "log": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "git": {
      "type": "string"
    },
    "settings": {
      "$ref": "#/$defs/gameSettings"
    },
    "gameSettings": {
      "$ref": "#/$defs/gameSettings"
    },
    "mode": {
      "$ref": "./mode.schema.json"
    },
    "modifiers": {
      "type": "array"
    },
    "encounterDeckSize": {
      "type": "integer",
      "minimum": 0
    },
    "locations": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/uuidMapKey"
      },
      "additionalProperties": {
        "$ref": "./location.schema.json"
      }
    },
    "investigators": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/cardCodeMapKey"
      },
      "additionalProperties": {
        "$ref": "./investigator.schema.json"
      }
    },
    "otherInvestigators": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/cardCodeMapKey"
      },
      "additionalProperties": {
        "$ref": "./investigator.schema.json"
      }
    },
    "killedInvestigators": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/cardCodeMapKey"
      },
      "additionalProperties": {
        "$ref": "./investigator.schema.json"
      }
    },
    "enemies": {
      "$ref": "#/$defs/uuidEntityMap"
    },
    "assets": {
      "$ref": "#/$defs/uuidEntityMap"
    },
    "acts": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/cardCodeMapKey"
      },
      "additionalProperties": {
        "$ref": "./act.schema.json"
      }
    },
    "agendas": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/cardCodeMapKey"
      },
      "additionalProperties": {
        "$ref": "./agenda.schema.json"
      }
    },
    "treacheries": {
      "$ref": "#/$defs/uuidEntityMap"
    },
    "events": {
      "$ref": "#/$defs/uuidEntityMap"
    },
    "concealed": {
      "$ref": "#/$defs/uuidEntityMap"
    },
    "skills": {
      "$ref": "#/$defs/uuidEntityMap"
    },
    "stories": {
      "$ref": "#/$defs/cardCodeEntityMap"
    },
    "scarletKeys": {
      "$ref": "#/$defs/cardCodeEntityMap"
    },
    "playerCount": {
      "type": "integer"
    },
    "activeInvestigatorId": {
      "type": "string"
    },
    "activePlayerId": {
      "type": "string",
      "format": "uuid"
    },
    "turnPlayerInvestigatorId": {
      "type": [
        "string",
        "null"
      ]
    },
    "leadInvestigatorId": {
      "type": "string"
    },
    "playerOrder": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phase": {
      "enum": [
        "MythosPhase",
        "InvestigationPhase",
        "EnemyPhase",
        "UpkeepPhase",
        "ResolutionPhase",
        "CampaignPhase"
      ]
    },
    "phaseStep": {
      "$ref": "./phase-step.schema.json"
    },
    "inAction": {
      "type": "boolean"
    },
    "skillTest": {
      "type": [
        "object",
        "null"
      ]
    },
    "skillTestChaosTokens": {
      "$ref": "#/$defs/objectArray"
    },
    "focusedCards": {
      "$ref": "#/$defs/objectArray"
    },
    "highlightedCards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "focusedTarotCards": {
      "$ref": "#/$defs/objectArray"
    },
    "foundCards": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/objectArray"
      }
    },
    "focusedChaosTokens": {
      "$ref": "#/$defs/objectArray"
    },
    "activeCard": {
      "type": [
        "object",
        "null"
      ]
    },
    "removedFromPlay": {
      "$ref": "#/$defs/objectArray"
    },
    "gameState": {
      "$ref": "./game-state.schema.json"
    },
    "inSetup": {
      "type": "boolean"
    },
    "skillTestResults": {
      "type": [
        "object",
        "null"
      ]
    },
    "question": {
      "$ref": "#/$defs/uuidEntityMap"
    },
    "cards": {
      "$ref": "#/$defs/uuidEntityMap"
    },
    "totalDoom": {
      "type": "integer"
    },
    "totalClues": {
      "type": "integer"
    },
    "scenarioSteps": {
      "type": "integer",
      "minimum": 0
    },
    "undoActionStep": {
      "$ref": "#/$defs/nullableStep"
    },
    "undoTurnStep": {
      "$ref": "#/$defs/nullableStep"
    },
    "undoPhaseStep": {
      "$ref": "#/$defs/nullableStep"
    },
    "undoRoundStep": {
      "$ref": "#/$defs/nullableStep"
    },
    "roundHistory": {
      "$ref": "#/$defs/cardCodeEntityMap"
    },
    "phaseHistory": {
      "$ref": "#/$defs/cardCodeEntityMap"
    },
    "turnHistory": {
      "$ref": "#/$defs/cardCodeEntityMap"
    },
    "enemyAttackTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enemy",
          "target"
        ],
        "properties": {
          "enemy": {
            "type": "string"
          },
          "target": {
            "type": "object"
          }
        }
      }
    }
  },
  "$defs": {
    "uuidEntityMap": {
      "description": "Wire shape for maps keyed by a UUID-backed newtype whose ToJSONKey is `deriving newtype` from the wrapped UUID (Arkham/Id.hs): EnemyId, AssetId, TreacheryId, EventId, SkillId, ConcealedCardId (enemies/assets/treacheries/events/skills/concealed), PlayerId (question), and CardId (cards, Arkham/Card/Id.hs). Entity value shapes remain an intentionally broad object placeholder -- out of scope for this map-key slice.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/uuidMapKey"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "cardCodeEntityMap": {
      "description": "Wire shape for maps keyed by a CardCode-backed newtype whose ToJSONKey is `deriving newtype` from CardCode (Arkham/Id.hs): StoryId (stories), ScarletKeyId (scarletKeys, Arkham/Campaigns/TheScarletKeys/Key/Id.hs), and InvestigatorId (roundHistory/phaseHistory/turnHistory, Map InvestigatorId History in Arkham/Game/Base.hs). Entity value shapes remain an intentionally broad object placeholder -- out of scope for this map-key slice.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/cardCodeMapKey"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "uuidMapKey": {
      "description": "Wire key for maps keyed by a UUID-backed newtype (e.g. LocationId, Arkham/Id.hs), whose ToJSONKey is the underlying UUID's textual form.",
      "type": "string",
      "format": "uuid"
    },
    "cardCodeMapKey": {
      "description": "Wire key for maps keyed by a CardCode-backed newtype (e.g. InvestigatorId, ActId, AgendaId, Arkham/Id.hs). CardCode itself (Arkham/Card/CardCode.hs) is `newtype CardCode = CardCode Text` with no character-class constraint at the type level; its ToJSONKey instance (`toJSONKeyText (T.cons 'c' . unCardCode)`) only ever prepends a literal 'c'. Constrained here to the same broad `^c[0-9a-z:._-]+$` grammar used by the `cardCode`/`id` fields elsewhere in these schemas (every one of the 815 real card codes in data/cards.json satisfies it), rather than the official 5-digit-plus-suffix form alone, since homebrew/unofficial codes are ordinary Text and are not required to follow that narrower shape.",
      "type": "string",
      "pattern": "^c[0-9a-z:._-]+$"
    },
    "objectArray": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nullableStep": {
      "type": [
        "integer",
        "null"
      ]
    },
    "gameSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settingsAbilitiesCannotReactToThemselves",
        "settingsAchievementsEnabled",
        "settingsAsIfRuling",
        "settingsRolledUltimatumOrBoon",
        "settingsScreamedAllies",
        "settingsStrictAsIfAt",
        "settingsUltimatumsAndBoons",
        "settingsUltimatumsAndBoonsEnabled"
      ],
      "properties": {
        "settingsAbilitiesCannotReactToThemselves": {
          "type": "boolean"
        },
        "settingsAchievementsEnabled": {
          "type": "boolean"
        },
        "settingsAsIfRuling": {
          "enum": [
            "chapter1",
            "chapter2"
          ]
        },
        "settingsRolledUltimatumOrBoon": {
          "type": [
            "string",
            "null"
          ]
        },
        "settingsScreamedAllies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "settingsStrictAsIfAt": {
          "type": "boolean"
        },
        "settingsUltimatumsAndBoons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "settingsUltimatumsAndBoonsEnabled": {
          "type": "boolean"
        }
      }
    }
  }
}
