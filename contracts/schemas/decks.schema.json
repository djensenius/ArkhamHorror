{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkhamhorror.app/contracts/decks.schema.json",
  "title": "Decks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "createDeck",
    "fetchDeck",
    "validateDeckList",
    "normalizedDeckList",
    "deck",
    "validationErrors",
    "operationError"
  ],
  "properties": {
    "createDeck": {
      "$ref": "#/$defs/createDeckRequest"
    },
    "fetchDeck": {
      "$ref": "#/$defs/fetchDeckRequest"
    },
    "validateDeckList": {
      "$ref": "#/$defs/deckListInput"
    },
    "normalizedDeckList": {
      "$ref": "#/$defs/deckList"
    },
    "deck": {
      "$ref": "#/$defs/deck"
    },
    "validationErrors": {
      "$ref": "#/$defs/deckValidationErrors"
    },
    "operationError": {
      "$ref": "#/$defs/deckOperationError"
    }
  },
  "$defs": {
    "cardQuantityMapInput": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "integer"
      }
    },
    "cardQuantityMap": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^c.+"
      },
      "additionalProperties": {
        "type": "integer"
      }
    },
    "deckListInput": {
      "type": "object",
      "required": [
        "slots",
        "investigator_code"
      ],
      "properties": {
        "slots": {
          "$ref": "#/$defs/cardQuantityMapInput"
        },
        "sideSlots": {
          "oneOf": [
            {
              "$ref": "#/$defs/cardQuantityMapInput"
            },
            {
              "type": "array",
              "maxItems": 0
            }
          ]
        },
        "investigator_code": {
          "type": "string",
          "minLength": 1
        },
        "investigator_name": {
          "type": "string"
        },
        "meta": {
          "type": [
            "string",
            "null"
          ]
        },
        "taboo_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "id": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "deckList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slots",
        "sideSlots",
        "investigator_code",
        "investigator_name",
        "meta",
        "taboo_id",
        "url",
        "id",
        "name"
      ],
      "properties": {
        "slots": {
          "$ref": "#/$defs/cardQuantityMap"
        },
        "sideSlots": {
          "$ref": "#/$defs/cardQuantityMap"
        },
        "investigator_code": {
          "type": "string",
          "pattern": "^c.+"
        },
        "investigator_name": {
          "type": "string"
        },
        "meta": {
          "type": [
            "string",
            "null"
          ]
        },
        "taboo_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "createDeckRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deckId",
        "deckName",
        "deckList"
      ],
      "properties": {
        "deckId": {
          "type": "string"
        },
        "deckName": {
          "type": "string"
        },
        "deckUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "deckList": {
          "$ref": "#/$defs/deckListInput"
        }
      }
    },
    "fetchDeckRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "userId",
        "url",
        "name",
        "investigatorName",
        "list"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "userId": {
          "type": "integer"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "name": {
          "type": "string"
        },
        "investigatorName": {
          "type": "string"
        },
        "list": {
          "$ref": "#/$defs/deckList"
        }
      }
    },
    "deckListResponse": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deck"
      }
    },
    "deckValidationError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "const": "UnimplementedCard"
        },
        "contents": {
          "type": "string",
          "pattern": "^c.+"
        }
      }
    },
    "deckValidationErrors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/deckValidationError"
      }
    },
    "deckOperationError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "errorMsg"
      ],
      "properties": {
        "errorMsg": {
          "type": "string"
        }
      }
    }
  }
}
