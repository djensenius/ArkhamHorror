{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkhamhorror.app/contracts/campaign-catalog.schema.json",
  "title": "Campaign and scenario catalog",
  "description": "Generated native-client catalog for create-game campaign and scenario choices. Names are i18n keys resolved through the locale catalog; English source titles from the web data are not exposed in this artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogRevision",
    "endpoint",
    "digestAlgorithm",
    "campaigns",
    "scenarios",
    "sideStories",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "catalogRevision": {
      "type": "string",
      "pattern": "^1\\.[0-9a-f]{32}$"
    },
    "endpoint": {
      "const": "/api/v1/arkham/campaign-catalog"
    },
    "digestAlgorithm": {
      "const": "sha256"
    },
    "campaigns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/campaign"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "sideStories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sideStory"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9:_-]+$",
      "minLength": 1,
      "maxLength": 128
    },
    "i18nKey": {
      "type": "string",
      "pattern": "^catalogNames\\.(campaigns|scenarios|sideStories)\\.[A-Za-z0-9:_-]+(\\.returnTo|\\.parts\\.[A-Za-z0-9:_-]+)?\\.name$",
      "minLength": 1,
      "maxLength": 256
    },
    "difficulty": {
      "enum": [
        "Easy",
        "Standard",
        "Hard",
        "Expert"
      ]
    },
    "tokenFace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "difficultyLevels": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/difficulty"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/tokenFace"
        }
      }
    },
    "releaseFields": {
      "type": "object",
      "properties": {
        "alpha": {
          "type": "boolean"
        },
        "beta": {
          "type": "boolean"
        },
        "dev": {
          "type": "boolean"
        }
      }
    },
    "returnToCampaign": {
      "allOf": [
        {
          "$ref": "#/$defs/releaseFields"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "nameKey"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "nameKey": {
              "$ref": "#/$defs/i18nKey"
            },
            "alpha": {
              "type": "boolean"
            },
            "beta": {
              "type": "boolean"
            },
            "dev": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "campaign": {
      "allOf": [
        {
          "$ref": "#/$defs/releaseFields"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "id",
            "nameKey"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "nameKey": {
              "$ref": "#/$defs/i18nKey"
            },
            "difficultyLevels": {
              "$ref": "#/$defs/difficultyLevels"
            },
            "returnTo": {
              "$ref": "#/$defs/returnToCampaign"
            },
            "variants": {
              "type": "array"
            },
            "recommendedOptions": {
              "type": "array"
            },
            "settings": {
              "type": "array"
            },
            "name": false
          }
        }
      ]
    },
    "scenarioBase": {
      "allOf": [
        {
          "$ref": "#/$defs/releaseFields"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "id",
            "nameKey"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "nameKey": {
              "$ref": "#/$defs/i18nKey"
            },
            "campaign": {
              "$ref": "#/$defs/id"
            },
            "returnTo": {
              "$ref": "#/$defs/id"
            },
            "returnToNameKey": {
              "$ref": "#/$defs/i18nKey"
            },
            "standaloneDifficulties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/difficulty"
              },
              "uniqueItems": true
            },
            "difficultyLevels": {
              "$ref": "#/$defs/difficultyLevels"
            },
            "settings": {
              "type": "array"
            },
            "requiredInvestigator": {
              "type": "string",
              "minLength": 1
            },
            "deckRequirements": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "name": false
          }
        }
      ]
    },
    "scenario": {
      "$ref": "#/$defs/scenarioBase"
    },
    "sideStoryPart": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "nameKey"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "nameKey": {
          "$ref": "#/$defs/i18nKey"
        },
        "box": {
          "$ref": "#/$defs/id"
        },
        "notAfter": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "name": false
      }
    },
    "sideStory": {
      "allOf": [
        {
          "$ref": "#/$defs/scenarioBase"
        },
        {
          "type": "object",
          "properties": {
            "scenarios": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/sideStoryPart"
              }
            }
          }
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator",
        "generatorVersion",
        "schemaVersion",
        "schemaRevision",
        "dataSourcesSha256",
        "generatorSha256",
        "schemasSha256",
        "sha256",
        "sources",
        "outputSha256"
      ],
      "properties": {
        "generator": {
          "const": "arkham-campaign-catalog"
        },
        "generatorVersion": {
          "const": "1.0.0"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "schemaRevision": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "dataSourcesSha256": {
          "$ref": "#/$defs/sha256"
        },
        "generatorSha256": {
          "$ref": "#/$defs/sha256"
        },
        "schemasSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceDigest"
          }
        },
        "outputSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
