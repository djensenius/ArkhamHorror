{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkhamhorror.app/contracts/basic-choice-question.schema.json",
  "title": "BasicChoiceQuestion",
  "description": "The closed native-renderable ChooseOne/ChooseOneAtATime/PlayerWindowChooseOne/WindowChooseOne/Read and isolated wrapped-question slice, including the opening mulligan, basic-investigation controls, mythos encounter-deck draw, the exact single-enemy regular-attack ordering prompt, and its exact 1 damage / 1 horror assignment prompt. Unknown top-level questions remain opaque in PublicGame.question; they do not validate here. The choices/readChoices array index is the zero-based Answer.choice.",
  "oneOf": [
    {
      "$ref": "#/$defs/chooseOneQuestion"
    },
    {
      "$ref": "#/$defs/chooseOneAtATimeEnemyAttackQuestion"
    },
    {
      "$ref": "#/$defs/enemyAttackDamageAssignmentQuestion"
    },
    {
      "$ref": "#/$defs/playerWindowChooseOneQuestion"
    },
    {
      "$ref": "#/$defs/windowChooseOneQuestion"
    },
    {
      "$ref": "#/$defs/readQuestion"
    }
  ],
  "$defs": {
    "chooseOneQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "choices"
      ],
      "properties": {
        "tag": {
          "const": "ChooseOne"
        },
        "choices": {
          "$ref": "#/$defs/choices"
        }
      }
    },
    "chooseOneAtATimeEnemyAttackQuestion": {
      "title": "Resolve enemy attack",
      "description": "The isolated production enemy-phase ordering prompt for exactly one regular attack. This root branch is deliberately separate from generic choiceLabel/choiceTarget/messages: no other ChooseOneAtATime shape and no other EnemyTarget or enemy-attack message is governed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "choices"
      ],
      "properties": {
        "tag": {
          "const": "ChooseOneAtATime"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/enemyAttackLabel"
          }
        }
      }
    },
    "enemyAttackLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "target",
        "messages"
      ],
      "properties": {
        "tag": {
          "const": "TargetLabel"
        },
        "target": {
          "$ref": "#/$defs/enemyAttackTarget"
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/enemyAttackMessage"
          }
        }
      }
    },
    "enemyAttackTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "const": "EnemyTarget"
        },
        "contents": {
          "$ref": "./uuid.schema.json"
        }
      }
    },
    "enemyAttackMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "const": "EnemyAttackMessage"
        },
        "contents": {
          "$ref": "#/$defs/enemyAttackConstructor"
        }
      }
    },
    "enemyAttackConstructor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "const": "EnemyAttack_"
        },
        "contents": {
          "$ref": "#/$defs/enemyAttackDetails"
        }
      }
    },
    "enemyAttackDetails": {
      "description": "The exact EnemyAttackDetails emitted for a ready Swarm of Rats' ordinary enemy-phase attack. JSON Schema cannot express equality among the repeated enemy UUIDs or between both investigator targets; production-value Haskell assertions bind those identities.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attackTarget",
        "attackOriginalTarget",
        "attackEnemy",
        "attackType",
        "attackDamageStrategy",
        "attackExhaustsEnemy",
        "attackSource",
        "attackCanBeCanceled",
        "attackAfter",
        "attackDamaged",
        "attackDealDamage",
        "attackDespiteExhausted",
        "attackCancelled"
      ],
      "properties": {
        "attackTarget": {
          "$ref": "#/$defs/singleInvestigatorAttackTarget"
        },
        "attackOriginalTarget": {
          "$ref": "#/$defs/singleInvestigatorAttackTarget"
        },
        "attackEnemy": {
          "$ref": "./uuid.schema.json"
        },
        "attackType": {
          "const": "RegularAttack"
        },
        "attackDamageStrategy": {
          "$ref": "#/$defs/damageAny"
        },
        "attackExhaustsEnemy": {
          "const": true
        },
        "attackSource": {
          "$ref": "#/$defs/enemySource"
        },
        "attackCanBeCanceled": {
          "const": true
        },
        "attackAfter": {
          "const": []
        },
        "attackDamaged": {
          "const": []
        },
        "attackDealDamage": {
          "const": true
        },
        "attackDespiteExhausted": {
          "const": false
        },
        "attackCancelled": {
          "const": false
        }
      }
    },
    "singleInvestigatorAttackTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "const": "SingleAttackTarget"
        },
        "contents": {
          "$ref": "#/$defs/attackInvestigatorTarget"
        }
      }
    },
    "attackInvestigatorTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "const": "InvestigatorTarget"
        },
        "contents": {
          "$ref": "#/$defs/investigatorId"
        }
      }
    },
    "damageAny": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag"
      ],
      "properties": {
        "tag": {
          "const": "DamageAny"
        }
      }
    },
    "enemySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "const": "EnemySource"
        },
        "contents": {
          "$ref": "./uuid.schema.json"
        }
      }
    },
    "enemyAttackDamageAssignmentQuestion": {
      "title": "Assign 1 damage and 1 horror",
      "description": "The isolated production QuestionWithSource -> QuestionLabel -> ChooseOne prompt emitted after the governed Ghoul Minion regular attack. The two fixed array positions are the Answer.choice source indices: 0 assigns damage first and 1 assigns horror first. No generic QuestionWithSource, QuestionLabel, ComponentLabel, InvestigatorMessage, damage assignment, or arbitrary attack amount is authorized by this branch.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "source",
        "tooltip",
        "question"
      ],
      "properties": {
        "tag": {
          "const": "QuestionWithSource"
        },
        "source": {
          "$ref": "#/$defs/enemyAttackSource"
        },
        "tooltip": {
          "type": "null"
        },
        "question": {
          "$ref": "#/$defs/enemyAttackDamageAssignmentLabel"
        }
      }
    },
    "enemyAttackDamageAssignmentLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "label",
        "card",
        "question"
      ],
      "properties": {
        "tag": {
          "const": "QuestionLabel"
        },
        "label": {
          "const": "Assign 1 damage and 1 horror"
        },
        "card": {
          "type": "null"
        },
        "question": {
          "$ref": "#/$defs/enemyAttackDamageAssignmentChoices"
        }
      }
    },
    "enemyAttackDamageAssignmentChoices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "choices"
      ],
      "properties": {
        "tag": {
          "const": "ChooseOne"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/enemyAttackAssignDamageChoice"
            },
            {
              "$ref": "#/$defs/enemyAttackAssignHorrorChoice"
            }
          ],
          "items": false
        }
      }
    },
    "enemyAttackAssignDamageChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "component",
        "messages"
      ],
      "properties": {
        "tag": {
          "const": "ComponentLabel"
        },
        "component": {
          "$ref": "#/$defs/damageAssignmentComponent"
        },
        "messages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/assignDamageFirstMessage"
            },
            {
              "$ref": "#/$defs/continueAfterDamageFirstMessage"
            }
          ],
          "items": false
        }
      }
    },
    "enemyAttackAssignHorrorChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "component",
        "messages"
      ],
      "properties": {
        "tag": {
          "const": "ComponentLabel"
        },
        "component": {
          "$ref": "#/$defs/horrorAssignmentComponent"
        },
        "messages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/assignHorrorFirstMessage"
            },
            {
              "$ref": "#/$defs/continueAfterHorrorFirstMessage"
            }
          ],
          "items": false
        }
      }
    },
    "damageAssignmentComponent": {
      "$ref": "#/$defs/damageAssignmentInvestigatorComponent",
      "properties": {
        "tokenType": {
          "const": "DamageToken"
        }
      }
    },
    "horrorAssignmentComponent": {
      "$ref": "#/$defs/damageAssignmentInvestigatorComponent",
      "properties": {
        "tokenType": {
          "const": "HorrorToken"
        }
      }
    },
    "damageAssignmentInvestigatorComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "investigatorId",
        "tokenType"
      ],
      "properties": {
        "tag": {
          "const": "InvestigatorComponent"
        },
        "investigatorId": {
          "$ref": "#/$defs/investigatorId"
        },
        "tokenType": {
          "enum": [
            "DamageToken",
            "HorrorToken"
          ]
        }
      }
    },
    "assignDamageFirstMessage": {
      "$ref": "#/$defs/investigatorDamageMessage",
      "properties": {
        "contents": {
          "$ref": "#/$defs/directDamageOneHorrorZero"
        }
      }
    },
    "assignHorrorFirstMessage": {
      "$ref": "#/$defs/investigatorDamageMessage",
      "properties": {
        "contents": {
          "$ref": "#/$defs/directDamageZeroHorrorOne"
        }
      }
    },
    "investigatorDamageMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "const": "InvestigatorMessage"
        },
        "contents": {
          "$ref": "#/$defs/investigatorDamageConstructor"
        }
      }
    },
    "investigatorDamageConstructor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "const": "InvestigatorDamage_"
        },
        "contents": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "$ref": "#/$defs/investigatorId"
            },
            {
              "$ref": "#/$defs/enemyAttackSource"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "items": false
        }
      }
    },
    "directDamageOneHorrorZero": {
      "type": "object",
      "properties": {
        "contents": {
          "prefixItems": [
            {
              "$ref": "#/$defs/investigatorId"
            },
            {
              "$ref": "#/$defs/enemyAttackSource"
            },
            {
              "const": 1
            },
            {
              "const": 0
            }
          ]
        }
      }
    },
    "directDamageZeroHorrorOne": {
      "type": "object",
      "properties": {
        "contents": {
          "prefixItems": [
            {
              "$ref": "#/$defs/investigatorId"
            },
            {
              "$ref": "#/$defs/enemyAttackSource"
            },
            {
              "const": 0
            },
            {
              "const": 1
            }
          ]
        }
      }
    },
    "continueAfterDamageFirstMessage": {
      "$ref": "#/$defs/investigatorDoAssignDamageMessage",
      "properties": {
        "contents": {
          "$ref": "#/$defs/remainingHorrorAssignment"
        }
      }
    },
    "continueAfterHorrorFirstMessage": {
      "$ref": "#/$defs/investigatorDoAssignDamageMessage",
      "properties": {
        "contents": {
          "$ref": "#/$defs/remainingDamageAssignment"
        }
      }
    },
    "investigatorDoAssignDamageMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "const": "InvestigatorMessage"
        },
        "contents": {
          "$ref": "#/$defs/investigatorDoAssignDamageConstructor"
        }
      }
    },
    "investigatorDoAssignDamageConstructor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "const": "InvestigatorDoAssignDamage_"
        },
        "contents": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "prefixItems": [
            {
              "$ref": "#/$defs/investigatorId"
            },
            {
              "$ref": "#/$defs/enemyAttackSource"
            },
            {
              "$ref": "#/$defs/damageAny"
            },
            {
              "$ref": "#/$defs/anyAsset"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            {
              "$ref": "#/$defs/investigatorTargetCandidates"
            },
            {
              "$ref": "#/$defs/investigatorTargetCandidates"
            }
          ],
          "items": false
        }
      }
    },
    "remainingHorrorAssignment": {
      "type": "object",
      "properties": {
        "contents": {
          "prefixItems": [
            {
              "$ref": "#/$defs/investigatorId"
            },
            {
              "$ref": "#/$defs/enemyAttackSource"
            },
            {
              "$ref": "#/$defs/damageAny"
            },
            {
              "$ref": "#/$defs/anyAsset"
            },
            {
              "const": 0
            },
            {
              "const": 1
            },
            {
              "$ref": "#/$defs/singleInvestigatorTargetCandidates"
            },
            {
              "const": []
            }
          ]
        }
      }
    },
    "remainingDamageAssignment": {
      "type": "object",
      "properties": {
        "contents": {
          "prefixItems": [
            {
              "$ref": "#/$defs/investigatorId"
            },
            {
              "$ref": "#/$defs/enemyAttackSource"
            },
            {
              "$ref": "#/$defs/damageAny"
            },
            {
              "$ref": "#/$defs/anyAsset"
            },
            {
              "const": 1
            },
            {
              "const": 0
            },
            {
              "const": []
            },
            {
              "$ref": "#/$defs/singleInvestigatorTargetCandidates"
            }
          ]
        }
      }
    },
    "enemyAttackSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "const": "EnemyAttackSource"
        },
        "contents": {
          "$ref": "./uuid.schema.json"
        }
      }
    },
    "anyAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag"
      ],
      "properties": {
        "tag": {
          "const": "AnyAsset"
        }
      }
    },
    "investigatorTargetCandidates": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/attackInvestigatorTarget"
      }
    },
    "singleInvestigatorTargetCandidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/attackInvestigatorTarget"
      }
    },
    "playerWindowChooseOneQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "choices"
      ],
      "properties": {
        "tag": {
          "const": "PlayerWindowChooseOne"
        },
        "choices": {
          "$ref": "#/$defs/choices"
        }
      }
    },
    "windowChooseOneQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "choices"
      ],
      "properties": {
        "tag": {
          "const": "WindowChooseOne"
        },
        "choices": {
          "$ref": "#/$defs/choices"
        }
      }
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/choiceLabel"
      }
    },
    "choiceLabel": {
      "oneOf": [
        {
          "$ref": "#/$defs/componentLabel"
        },
        {
          "$ref": "#/$defs/mulliganDoneLabel"
        },
        {
          "$ref": "#/$defs/endTurnButton"
        },
        {
          "$ref": "#/$defs/abilityLabel"
        },
        {
          "$ref": "#/$defs/targetLabel"
        },
        {
          "$ref": "#/$defs/encounterDeckDrawLabel"
        },
        {
          "$ref": "#/$defs/skipTriggersButton"
        },
        {
          "$ref": "#/$defs/startSkillTestButton"
        },
        {
          "$ref": "#/$defs/skillTestApplyResultsButton"
        }
      ]
    },
    "mulliganDoneLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "label",
        "messages"
      ],
      "properties": {
        "tag": {
          "const": "Label"
        },
        "label": {
          "const": "$label.doneWithMulligan"
        },
        "messages": {
          "$ref": "#/$defs/messages"
        }
      },
      "description": "The production opening-mulligan completion action. This narrow branch does not claim support for arbitrary Label values."
    },
    "componentLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "component",
        "messages"
      ],
      "properties": {
        "tag": {
          "const": "ComponentLabel"
        },
        "component": {
          "$ref": "#/$defs/component"
        },
        "messages": {
          "$ref": "#/$defs/messages"
        }
      }
    },
    "endTurnButton": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "investigatorId",
        "messages"
      ],
      "properties": {
        "tag": {
          "const": "EndTurnButton"
        },
        "investigatorId": {
          "$ref": "#/$defs/investigatorId"
        },
        "messages": {
          "$ref": "#/$defs/messages"
        }
      }
    },
    "skipTriggersButton": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "investigatorId"
      ],
      "properties": {
        "tag": {
          "const": "SkipTriggersButton"
        },
        "investigatorId": {
          "$ref": "#/$defs/investigatorId"
        }
      },
      "description": "The skippable player-window control. Unlike message-bearing labels, its production Aeson shape has no messages field."
    },
    "startSkillTestButton": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "investigatorId"
      ],
      "properties": {
        "tag": {
          "const": "StartSkillTestButton"
        },
        "investigatorId": {
          "$ref": "#/$defs/investigatorId"
        }
      },
      "description": "The commit-step control that advances the authoritative skill test. Its production Aeson shape has no messages field."
    },
    "skillTestApplyResultsButton": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag"
      ],
      "properties": {
        "tag": {
          "const": "SkillTestApplyResultsButton"
        }
      },
      "description": "The exact zero-payload control emitted after the backend determines the skill-test result."
    },
    "abilityLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "investigatorId",
        "ability",
        "windows",
        "before",
        "messages"
      ],
      "properties": {
        "tag": {
          "const": "AbilityLabel"
        },
        "investigatorId": {
          "$ref": "#/$defs/investigatorId"
        },
        "ability": {
          "$ref": "#/$defs/abilityDisplay"
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/engineObject"
          }
        },
        "before": {
          "$ref": "#/$defs/messages"
        },
        "messages": {
          "$ref": "#/$defs/messages"
        }
      }
    },
    "targetLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "target",
        "messages"
      ],
      "properties": {
        "tag": {
          "const": "TargetLabel"
        },
        "target": {
          "$ref": "#/$defs/choiceTarget"
        },
        "messages": {
          "$ref": "#/$defs/messages"
        }
      },
      "description": "The LocationTarget (starting location) and CardIdTarget (mulligan, playable-window, and skill-test commit choices) variants retain opaque messages. EncounterDeckTarget is governed separately by encounterDeckDrawLabel with closed draw messages, and EnemyTarget only by the isolated ChooseOneAtATime enemy-attack root, so neither can bypass its closed schema through this generic branch. Other Target constructors remain unsupported here and opaque inside PublicGame."
    },
    "encounterDeckDrawLabel": {
      "title": "Draw encounter card",
      "description": "The semantic choice label for the production mythos encounter draw. Native clients present 'Draw encounter card' from this governed TargetLabel(EncounterDeckTarget) identity, not by interpreting messages or deriving game rules. Submit only the unchanged source array index using the existing versioned Answer.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "target",
        "messages"
      ],
      "properties": {
        "tag": {
          "const": "TargetLabel"
        },
        "target": {
          "$ref": "#/$defs/encounterDeckTarget"
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/encounterDrawCards"
          }
        }
      }
    },
    "encounterDeckTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag"
      ],
      "properties": {
        "tag": {
          "const": "EncounterDeckTarget"
        }
      }
    },
    "encounterDrawCards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "const": "DrawCards"
        },
        "contents": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/investigatorId"
            },
            {
              "$ref": "#/$defs/encounterCardDraw"
            }
          ],
          "items": false
        }
      }
    },
    "encounterCardDraw": {
      "description": "Only the unmodified, unresolved, one-card mythos draw emitted by newCardDraw GameSource EncounterDeck 1 is governed. All twelve production fields are required, including the three null Maybe fields; their broader non-null engine unions, other draw states, rules, and previously drawn cards remain unsupported in this slice. The payload is data to preserve, never instructions for clients to execute.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cardDrawAction",
        "cardDrawAlreadyDrawn",
        "cardDrawAmount",
        "cardDrawAndThen",
        "cardDrawDeck",
        "cardDrawDiscard",
        "cardDrawKind",
        "cardDrawPosition",
        "cardDrawRules",
        "cardDrawSource",
        "cardDrawState",
        "cardDrawTarget"
      ],
      "properties": {
        "cardDrawAction": {
          "const": false
        },
        "cardDrawAlreadyDrawn": {
          "const": []
        },
        "cardDrawAmount": {
          "type": "integer",
          "const": 1
        },
        "cardDrawAndThen": {
          "type": "null"
        },
        "cardDrawDeck": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag"
          ],
          "properties": {
            "tag": {
              "const": "EncounterDeck"
            }
          }
        },
        "cardDrawDiscard": {
          "type": "null"
        },
        "cardDrawKind": {
          "const": "StandardCardDraw"
        },
        "cardDrawPosition": {
          "const": "DrawFromTop"
        },
        "cardDrawRules": {
          "const": []
        },
        "cardDrawSource": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag"
          ],
          "properties": {
            "tag": {
              "const": "GameSource"
            }
          }
        },
        "cardDrawState": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag"
          ],
          "properties": {
            "tag": {
              "const": "UnresolvedCardDraw"
            }
          }
        },
        "cardDrawTarget": {
          "type": "null"
        }
      }
    },
    "choiceTarget": {
      "oneOf": [
        {
          "$ref": "#/$defs/locationTarget"
        },
        {
          "$ref": "#/$defs/cardIdTarget"
        }
      ]
    },
    "locationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "const": "LocationTarget"
        },
        "contents": {
          "$ref": "./uuid.schema.json",
          "description": "The real LocationId (Arkham/Id.hs, deriving ToJSON newtype from UUID)."
        }
      }
    },
    "cardIdTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "const": "CardIdTarget"
        },
        "contents": {
          "$ref": "./uuid.schema.json",
          "description": "The canonical card-instance UUID used to resolve the target against PublicGame.cards and investigator hand state."
        }
      }
    },
    "component": {
      "oneOf": [
        {
          "$ref": "#/$defs/investigatorComponent"
        },
        {
          "$ref": "#/$defs/investigatorDeckComponent"
        }
      ]
    },
    "investigatorComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "investigatorId",
        "tokenType"
      ],
      "properties": {
        "tag": {
          "const": "InvestigatorComponent"
        },
        "investigatorId": {
          "$ref": "#/$defs/investigatorId"
        },
        "tokenType": {
          "const": "ResourceToken"
        }
      }
    },
    "investigatorDeckComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "investigatorId"
      ],
      "properties": {
        "tag": {
          "const": "InvestigatorDeckComponent"
        },
        "investigatorId": {
          "$ref": "#/$defs/investigatorId"
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "tag"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Guaranteed production Message constructor-object outer shape. Constructor-specific contents and additive fields are losslessly preserved engine-owned data, never client-side rules."
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/message"
      },
      "description": "Selecting a choice sends its array index. Native clients preserve these engine Message objects but never execute or synthesize actions from them."
    },
    "engineObject": {
      "type": "object",
      "additionalProperties": true,
      "description": "Explicit extension boundary for a nested engine-owned constructor object. Preserve all fields; do not interpret it as client-side game logic."
    },
    "abilityDisplay": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source",
        "cardCode",
        "index",
        "type"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/engineObject"
        },
        "cardCode": {
          "$ref": "#/$defs/cardCode",
          "description": "Card code used with source/type/index as display identity; it does not authorize or execute an ability."
        },
        "index": {
          "type": "integer"
        },
        "type": {
          "$ref": "#/$defs/abilityTypeDisplay"
        }
      },
      "description": "Explicit engine-owned extension boundary. Stable display identity is modeled; criteria, limits, costs, sources, and future additive fields are preserved data."
    },
    "abilityTypeDisplay": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "tag",
        "actions"
      ],
      "properties": {
        "tag": {
          "const": "ActionAbility"
        },
        "actions": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "tag",
            "contents"
          ],
          "properties": {
            "tag": {
              "const": "SingleAction"
            },
            "contents": {
              "const": "Investigate"
            }
          },
          "description": "The CORE fixture's stable action label/icon semantic. Additional engine-owned action data remains opaque."
        }
      },
      "description": "Only the CORE ActionAbility display semantic is supported. Cost and skill fields remain opaque engine-owned data."
    },
    "readQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "flavorText",
        "readChoices",
        "readCards"
      ],
      "properties": {
        "tag": {
          "const": "Read"
        },
        "flavorText": {
          "$ref": "#/$defs/flavorText"
        },
        "readChoices": {
          "$ref": "#/$defs/basicReadChoices"
        },
        "readCards": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/cardCode"
              }
            }
          ],
          "description": "Maybe [CardCode]: null when the story beat adds no cards (e.g. a plain setup-intro continue), an array of real card codes when it does (e.g. cards a scenario story adds to play). Never omitted: Aeson's default (non-omitting) Maybe encoding always emits this key."
        }
      },
      "description": "Only the governed BasicReadChoices continue shape (readChoices) is supported; BasicReadChoicesN/BasicReadChoicesUpToN/LeadInvestigatorMustDecide remain explicit unsupported values, closed out by basicReadChoices's own 'tag' const."
    },
    "basicReadChoices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "const": "BasicReadChoices"
        },
        "contents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/basicReadContinueLabel"
          }
        }
      },
      "description": "The governed shape is always exactly the single semantic continue choice Arkham.Message's story/storyWithCards/storyWithContinue build ('BasicReadChoices [Label \"$continue\" []]'); any other content is an explicit unsupported value."
    },
    "basicReadContinueLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "label",
        "messages"
      ],
      "properties": {
        "tag": {
          "const": "Label"
        },
        "label": {
          "const": "$continue"
        },
        "messages": {
          "const": []
        }
      },
      "description": "The exact, always-empty-messages semantic continue Label -- clients render this as a single dismiss/continue action, never as an arbitrary Label choice (unlike a real 'Label' elsewhere in Arkham.Question, which can carry nested messages and is out of scope for this narrow branch)."
    },
    "flavorText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "body"
      ],
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flavorTextEntry"
          }
        }
      },
      "description": "Arkham.Text.FlavorText {flavorTitle :: Maybe Text, flavorBody :: [FlavorTextEntry]}, encoded with its 'flavor' field prefix stripped (Arkham/Json.hs's aesonOptions). title is null (BasicReadChoices' plain story beats never set one) or a literal i18n key string; it is never rendered narrative text on the wire."
    },
    "flavorTextEntry": {
      "oneOf": [
        {
          "$ref": "#/$defs/basicEntry"
        },
        {
          "$ref": "#/$defs/i18nEntry"
        },
        {
          "$ref": "#/$defs/headerEntry"
        },
        {
          "$ref": "#/$defs/listEntry"
        }
      ],
      "description": "Only the four FlavorTextEntry (Arkham/Text.hs) constructors these fixtures actually exercise are supported; every other constructor (ModifyEntry, CompositeEntry, ColumnEntry, CardEntry, TarotEntry, ChaosTokenEntry, ChaosTokenMorphEntry, EntrySplit) remains an explicit unsupported value here, still opaque wherever it appears inside PublicGame."
    },
    "basicEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "text"
      ],
      "properties": {
        "tag": {
          "const": "BasicEntry"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "i18nEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "key",
        "variables"
      ],
      "properties": {
        "tag": {
          "const": "I18nEntry"
        },
        "key": {
          "$ref": "#/$defs/i18nKey",
          "description": "A dotted i18n lookup key, never rendered narrative text -- the client's own locale files supply the displayed text for this key."
        },
        "variables": {
          "type": "object"
        }
      }
    },
    "headerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "level",
        "key"
      ],
      "properties": {
        "tag": {
          "const": "HeaderEntry"
        },
        "level": {
          "type": "integer",
          "enum": [
            1,
            3
          ],
          "description": "The two heading levels currently emitted by Arkham.FlavorText.h/h1 and h3. Other integers remain unsupported until the production helpers and native presentation define their semantics."
        },
        "key": {
          "$ref": "#/$defs/i18nKey"
        }
      },
      "description": "A catalog-backed semantic heading. The current Vue reference renders level 1 as the primary story heading and level 3 as a subordinate heading."
    },
    "listEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "list"
      ],
      "properties": {
        "tag": {
          "const": "ListEntry"
        },
        "list": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listItemEntry"
          }
        }
      }
    },
    "listItemEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "nested"
      ],
      "properties": {
        "entry": {
          "$ref": "#/$defs/flavorTextEntry"
        },
        "nested": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listItemEntry"
          }
        }
      }
    },
    "investigatorId": {
      "$ref": "#/$defs/cardCode"
    },
    "i18nKey": {
      "description": "Dotted vue-i18n key using the locale-catalog message-key grammar.",
      "type": "string",
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f./\\\\\\ue000\\ue001]+(\\.[^\\u0000-\\u001f\\u007f./\\\\\\ue000\\ue001]+)*$"
    },
    "cardCode": {
      "type": "string",
      "pattern": "^c[0-9a-z:._-]+$"
    }
  }
}
