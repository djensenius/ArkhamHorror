{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkhamhorror.app/contracts/server-message.schema.json",
  "title": "ServerMessage",
  "description": "Every server-to-client WebSocket envelope emitted by ApiResponse.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "const": "GameUpdate"
        },
        "contents": {
          "$ref": "./public-game.schema.json"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "enum": [
            "GameMessage",
            "GameError",
            "GameUI",
            "GameAudio",
            "GameAchievement"
          ]
        },
        "contents": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "title",
        "card"
      ],
      "properties": {
        "tag": {
          "const": "GameCard"
        },
        "title": {
          "type": "string"
        },
        "card": {}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "player",
        "title",
        "card"
      ],
      "properties": {
        "tag": {
          "const": "GameCardOnly"
        },
        "player": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "card": {}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "const": "GameTarot"
        },
        "contents": {}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "enum": [
            "GameShowDiscard",
            "GameShowUnder"
          ]
        },
        "contents": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "cardId",
        "cardCode",
        "checks"
      ],
      "properties": {
        "tag": {
          "const": "GamePlayabilityInfo"
        },
        "cardId": {
          "type": "string",
          "format": "uuid"
        },
        "cardCode": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": [
                  "string",
                  "null"
                ]
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "contents"
      ],
      "properties": {
        "tag": {
          "const": "SharedStateUpdate"
        },
        "contents": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sharedVersion",
            "sharedCounters",
            "sharedTotalInvestigators",
            "sharedAppliedDeltas"
          ],
          "properties": {
            "sharedVersion": {
              "type": "integer",
              "minimum": 0
            },
            "sharedCounters": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "sharedTotalInvestigators": {
              "type": "integer",
              "minimum": 0
            },
            "sharedAppliedDeltas": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag"
      ],
      "properties": {
        "tag": {
          "const": "EventChanged"
        }
      }
    }
  ]
}
