events {}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

  # How long each class of asset may be cached.
  #
  # Vite emits content-hashed filenames under /assets/, so those bytes can
  # never change behind a URL — they get a year and `immutable`, which also
  # tells the browser not to revalidate on reload. Card images are addressed by
  # card code and are equally stable in practice, but aren't hash-named, so
  # they get a long TTL without `immutable`.
  #
  # Everything else revalidates. index.html especially: it names the hashed
  # bundles, so a stale copy points at asset URLs that no longer exist.
  map $uri $cache_control {
    default            "public, max-age=0, must-revalidate";
    "~^/assets/"       "public, max-age=31536000, immutable";
    "~^/img/"          "public, max-age=2592000";
    "~^/audio/"        "public, max-age=2592000";
    "~^/locale-catalog/c/" "public, max-age=31536000, immutable";
    "~^/locale-catalog/r/" "public, max-age=31536000, immutable";
  }

  # Cache policy for the locale catalog, chosen by *response status*, not by
  # path alone. A 404 or 405 under an immutable prefix would otherwise be
  # cached for a year — poisoning every client that raced a rolling deploy —
  # so only a real payload (200/206) or a revalidation (304) may be cached,
  # and every other status is explicitly non-storable.
  map $status $catalog_cache_control {
    default "no-store";
    200     $cache_control;
    206     $cache_control;
    304     $cache_control;
  }

  # Does this client accept brotli? Matched as a whole word so it can't be
  # fooled by a token like "brotli-ish" or a future "xbr".
  map $http_accept_encoding $accepts_br {
    default      0;
    "~*(^|,)\s*br\s*(;|,|$)" 1;
  }

  gzip on;
  gzip_static on;
  gzip_vary on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_types
    application/json
    application/javascript
    application/xml
    application/rss+xml
    application/atom+xml
    application/wasm
    image/svg+xml
    text/css
    text/javascript
    text/plain
    text/xml;

  server {
    listen 3000;
    server_name .arkhamhorror.app;
    client_max_body_size 5M;

    root /opt/arkham/src/frontend/dist;

    # Precompressed static delivery for the two directories the build fully
    # controls (scripts/precompress.cjs writes a .gz and a .br next to every
    # file in them). Ubuntu's nginx has no brotli module and nginx.org doesn't
    # package one, so brotli is served by hand:
    #
    #   client accepts br + .br exists -> rewrite to it, tag Content-Encoding
    #   client accepts gzip            -> gzip_static serves the .gz
    #   neither                        -> the raw file
    #
    # The `-f` test is what makes this safe. Content-Encoding is only ever set
    # on a request that is actually being answered with the .br file, so a file
    # the build skipped just falls through to gzip rather than being mislabeled.
    #
    # `gzip off` matters here: dynamic gzip would otherwise re-compress the
    # brotli bytes, because add_header sets Content-Encoding too late in the
    # filter chain for the gzip module to notice. gzip_static is a separate
    # module and keeps working with gzip off.
    #
    # These are split per extension because after the rewrite the filename ends
    # in .br, which isn't in mime.types — default_type supplies the real type.
    location ~* ^/assets/.+\.js$ {
      default_type application/javascript;
      gzip off;

      set $br "";
      if ($accepts_br) { set $br "y"; }
      if (-f "$request_filename.br") { set $br "${br}f"; }
      if ($br = "yf") {
        add_header Cache-Control $cache_control always;
        add_header Vary "Accept-Encoding" always;
        add_header Content-Encoding "br" always;
        rewrite ^(.*)$ $1.br break;
      }

      add_header Cache-Control $cache_control always;
    }

    location ~* ^/assets/.+\.css$ {
      default_type text/css;
      gzip off;

      set $br "";
      if ($accepts_br) { set $br "y"; }
      if (-f "$request_filename.br") { set $br "${br}f"; }
      if ($br = "yf") {
        add_header Cache-Control $cache_control always;
        add_header Vary "Accept-Encoding" always;
        add_header Content-Encoding "br" always;
        rewrite ^(.*)$ $1.br break;
      }

      add_header Cache-Control $cache_control always;
    }

    # The slimmed card database, ~6 MB of JSON per locale and the single
    # biggest thing a cold client downloads. Not content-hashed, so it
    # revalidates via ETag rather than caching immutably.
    location ~* ^/cards/.+\.json$ {
      default_type application/json;
      gzip off;

      set $br "";
      if ($accepts_br) { set $br "y"; }
      if (-f "$request_filename.br") { set $br "${br}f"; }
      if ($br = "yf") {
        add_header Cache-Control $cache_control always;
        add_header Vary "Accept-Encoding" always;
        add_header Content-Encoding "br" always;
        rewrite ^(.*)$ $1.br break;
      }

      add_header Cache-Control $cache_control always;
    }

    # The public locale catalog (see docs/locale-catalog.md). Two shapes:
    #
    #   /locale-catalog/manifest.json    the index a client starts from. Its
    #                                    bytes change whenever the catalog is
    #                                    regenerated, so it revalidates by ETag
    #                                    like index.html does.
    #   /locale-catalog/r/<rev>/...      content-addressed chunks and the
    #                                    immutable copy of the same manifest.
    #                                    The revision and the chunk's digest
    #                                    are both in the path, so those bytes
    #                                    can never change behind the URL. The
    #                                    $cache_control map gives that prefix a
    #                                    year and `immutable`; everything else
    #                                    here revalidates.
    #
    # Both are unauthenticated static JSON: no cookies, no tokens, no
    # per-request data in the response, and the same default access logging as
    # every other static asset — a catalog request records nothing an /assets
    # or /cards request would not. `nosniff` matters more here than on /cards
    # because native clients fetch these directly.
    #
    # `^~` (not a regex) so an unknown path under /locale-catalog/ 404s instead
    # of falling through to the SPA shell and answering a JSON fetch with HTML.
    #
    # `Vary: Accept-Encoding` is set here on the brotli branch and by the
    # http-level `gzip_vary on` (which covers gzip_static) on every other
    # response, so a shared cache never reuses one encoding for another.
    #
    # Chunk URLs under /locale-catalog/c/ carry only a content digest, so a
    # pack that did not change keeps its URL across revisions and remains
    # available from replicas running either revision during a rolling deploy.
    # A client that does hit a missing chunk gets an uncacheable 404 and can
    # re-fetch the manifest (see docs/locale-catalog.md).
    location ^~ /locale-catalog/ {
      default_type application/json;
      gzip off;

      set $br "";
      if ($accepts_br) { set $br "y"; }
      if (-f "$request_filename.br") { set $br "${br}f"; }
      if ($br = "yf") {
        add_header Cache-Control $catalog_cache_control always;
        add_header Vary "Accept-Encoding" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Encoding "br" always;
        rewrite ^(.*)$ $1.br break;
      }

      add_header Cache-Control $catalog_cache_control always;
      add_header X-Content-Type-Options "nosniff" always;
      # Stated unconditionally rather than left to gzip_vary, so the guarantee
      # holds for a native client even on a response nginx did not negotiate.
      add_header Vary "Accept-Encoding" always;

      # nginx's range filter runs *after* the header filter, so a 416 would
      # otherwise still carry the immutable policy computed for the 200 it
      # started as. Routing it through a named location re-writes the headers
      # once the status is final.
      error_page 416 = @locale_catalog_error;
    }

    location @locale_catalog_error {
      internal;
      default_type application/json;
      add_header Cache-Control "no-store" always;
      add_header X-Content-Type-Options "nosniff" always;
      return 416;
    }

    location / {
      try_files $uri $uri/ /index.html;
      add_header Cache-Control $cache_control always;
    }

    # ^~ so the regex locations above can't intercept an API path.
    location ^~ /api {
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_redirect off;
        proxy_pass_request_headers      on;
        proxy_pass http://localhost:3002;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        add_header P3P 'CP="ALL DSP COR PSAa PSDa OUR NOR ONL UNI COM NAV"';
    }

    location ^~ /health {
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_redirect off;
        proxy_pass_request_headers      on;
        proxy_pass http://localhost:3002;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        add_header P3P 'CP="ALL DSP COR PSAa PSDa OUR NOR ONL UNI COM NAV"';
    }
  }
}
